{
  "name": "@localapp/dsh-app-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./access-control": {
      "types": "./dist/access-control.d.cts",
      "default": "./dist/access-control.cjs"
    },
    "./app-db": {
      "types": "./dist/app-db.d.cts",
      "default": "./dist/app-db.cjs"
    },
    "./migrations": {
      "types": "./dist/migrations.d.cts",
      "default": "./dist/migrations.cjs"
    },
    "./runtime-errors": {
      "types": "./dist/runtime-errors.d.cts",
      "default": "./dist/runtime-errors.cjs"
    },
    "./issue-task-conversion": {
      "types": "./dist/issue-task-conversion.d.cts",
      "default": "./dist/issue-task-conversion.cjs"
    },
    "./notify-permission-sql": {
      "types": "./dist/notify-permission-sql.d.cts",
      "default": "./dist/notify-permission-sql.cjs"
    },
    "./models": {
      "types": "./dist/models.d.cts",
      "default": "./dist/models.cjs"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@localapp/dsh-multiuser": "workspace:*",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "rimraf": "^5.0.0",
    "typescript": "5.6.3",
    "@types/sql.js": "^1.4.11"
  }
}
