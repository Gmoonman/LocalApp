  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app-package-api": {
      "types": "./dist/app-package-api.d.ts",
      "default": "./dist/app-package-api.js"
    },
    "./device-action-ticket": {
      "types": "./dist/device-action-ticket.d.ts",
      "default": "./dist/device-action-ticket.js"
    },
    "./project-api": {
      "types": "./dist/project-api.d.ts",
      "default": "./dist/project-api.js"
    },
    "./project-api/backend": {
      "types": "./dist/project/backend.d.ts",
      "default": "./dist/project/backend.js"
    },
    "./project-api/check": {
      "types": "./dist/project/check.d.ts",
      "default": "./dist/project/check.js"
    },
    "./project-api/files": {
      "types": "./dist/project/files.d.ts",
      "default": "./dist/project/files.js"
    },
    "./project-api/manifest": {
      "types": "./dist/project/manifest.d.ts",
      "default": "./dist/project/manifest.js"
    },
    "./project-api/package": {
      "types": "./dist/project/package.d.ts",
      "default": "./dist/project/package.js"
    }
  },
  "scripts": {
    "dev": "pnpm -C ../dsh-multiuser build && pnpm -C ../dsh-app-platform build && pnpm -C ../dsh-app-development build && node scripts/build-native-client.mjs && node --import ./scripts/dev-env.mjs ./node_modules/tsx/dist/cli.mjs watch --include ../server-core/dist --include ../dsh-multiuser/dist --include ../dsh-app-platform/dist --include ../dsh-app-development/dist src/cli.ts start",
    "build": "pnpm -C ../dsh-multiuser build && pnpm -C ../dsh-app-platform build && pnpm -C ../dsh-app-development build && tsc",
    "start": "node dist/cli.js start",
    "package": "pnpm -C ../server-core build && pnpm -C ../web build && node scripts/build-server-package.mjs",
    "test:package": "node --test scripts/build-server-package.node-test.mjs",
    "test:local-dev-package": "pnpm -C ../server-core build && pnpm -C ../web build && node --test scripts/localapp-dev-package.node-test.mjs",
    "test": "vitest run",
    "test:runner-protocol": "node --test tests/runner-protocol.node-test.mjs",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
