{
  "name": "@patodo/localapp",
  "version": "0.6.0",
  "description": "LocalApp command-line interface",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Patodo/LocalApp.git"
  },
  "homepage": "https://github.com/Patodo/LocalApp#readme",
  "bugs": {
    "url": "https://github.com/Patodo/LocalApp/issues"
  },
  "type": "module",
  "bin": {
    "localapp": "bin/localapp.mjs"
  },
  "files": [
    "bin",
    "plugins",
    "runtime",
    "template",
    ".localapp-artifact.json"
  ],
  "exports": {
    "./plugins/multiuser": {
      "types": "./plugins/multiuser.d.mts",
      "default": "./plugins/multiuser.mjs"
    },
    "./plugins/applications": {
      "types": "./plugins/applications.d.mts",
      "default": "./plugins/applications.mjs"
    },
    "./plugins/development": {
      "types": "./plugins/development.d.mts",
      "default": "./plugins/development.mjs"
    },
    "./plugins/documents": {
      "types": "./plugins/documents.d.mts",
      "default": "./plugins/documents.mjs"
    },
    "./plugins/agent-ui": {
      "types": "./plugins/agent-ui.d.mts",
      "default": "./plugins/agent-ui.mjs"
    },
    "./plugins/model-settings": {
      "types": "./plugins/model-settings.d.mts",
      "default": "./plugins/model-settings.mjs"
    },
    "./plugins/agent-runtime": {
      "types": "./plugins/agent-runtime.d.mts",
      "default": "./plugins/agent-runtime.mjs"
    },
    "./plugins/agent-settings": {
      "types": "./plugins/agent-settings.d.mts",
      "default": "./plugins/agent-settings.mjs"
    },
    "./plugins/execution-environment": {
      "types": "./plugins/execution-environment.d.mts",
      "default": "./plugins/execution-environment.mjs"
    },
    "./plugins/app-sync": {
      "types": "./plugins/app-sync.d.mts",
      "default": "./plugins/app-sync.mjs"
    },
    "./plugins/collaboration": {
      "types": "./plugins/collaboration.d.mts",
      "default": "./plugins/collaboration.mjs"
    },
    "./plugins/device-services": {
      "types": "./plugins/device-services.d.mts",
      "default": "./plugins/device-services.mjs"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:native": "node scripts/build-native-adapter.mjs",
    "build:package": "node scripts/build-package.mjs",
    "prepack": "node scripts/prepare-pack.mjs",
    "postpack": "node scripts/cleanup-pack.mjs",
    "test": "vitest run",
    "test:native": "node --test scripts/native-adapter.node-test.mjs"
  },
  "devDependencies": {
    "@localapp/server": "workspace:*",
    "@types/node": "^25.9.1",
    "esbuild": "^0.27.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7",
    "ws": "^8.21.0",
    "@types/ws": "^8.18.1"
  }
}
