{
  "name": "localapp-workspace",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"pnpm -C packages/server dev\" \"pnpm -C packages/web dev\"",
    "dev:build": "pnpm -C packages/web build && pnpm -C packages/server dev",
    "dev:web": "pnpm -C packages/web build",
    "dev:server": "concurrently -k \"pnpm -C packages/server dev\" \"pnpm -C packages/web dev\"",
    "package:localapp": "node scripts/package-localapp.mjs",
    "release:npm:check": "node scripts/check-npm-release.mjs",
    "test:localapp-package": "node --test --test-concurrency=1 packages/localapp/scripts/pack-package.node-test.mjs packages/localapp/scripts/build-package.node-test.mjs packages/localapp/scripts/merge-native-adapters.node-test.mjs scripts/single-package-cutover.node-test.mjs",
    "test:local-dev-package": "pnpm -C packages/server-core build && pnpm -C packages/web build && node --test packages/server/scripts/localapp-dev-package.node-test.mjs",
    "generate:capabilities": "node scripts/generate-platform-capabilities.mjs",
    "check:capabilities": "node scripts/generate-platform-capabilities.mjs --check",
    "test:platform-regression": "node scripts/agent-first-run-benchmark.mjs deterministic",
    "test:windows-release-script": "node --test scripts/build-windows-release.node-test.mjs",
    "test:release-manifest": "node --test scripts/generate-release-manifest.node-test.mjs",
    "test:release-workflow": "node --test scripts/release-workflow.node-test.mjs",
    "test:public-source": "node --test scripts/export-public-source.node-test.mjs",
    "test:brand": "node --test scripts/localapp-brand.node-test.mjs",
    "export:public-source": "node scripts/export-public-source.mjs",
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "build:real-apps": "VITE_LOCALAPP_ACCEPTANCE_ROOT=\"$PWD/tmp/single-package-acceptance/installed-skills\" pnpm -C examples/skill-market build && pnpm -C examples/resume-manager build",
    "test:real-apps": "pnpm run build:real-apps && pnpm -C packages/server exec vitest run tests/e2e-unified/real-apps.spec.ts",
    "acceptance:local:start": "node scripts/single-package-acceptance.mjs start",
    "acceptance:local:stop": "node scripts/single-package-acceptance.mjs stop",
    "test:e2e-ui": "npx playwright test",
    "build:plugins": "node scripts/build-plugin-packages.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "concurrently": "^10.0.3"
  }
}
